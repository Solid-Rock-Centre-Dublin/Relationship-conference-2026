// Firestore security rules for the Q&A wall.
//
// 1. Replace the example email below with the email you will sign in with
//    on the question desk (lowercase). Add more emails inside the brackets,
//    separated by commas, if a second person needs access.
// 2. In the Firebase console go to Firestore Database, open the Rules tab,
//    paste this whole file in, and press Publish.
//
// What these rules do:
//   Anyone can add a question, but only a short, correctly shaped one.
//   Only the listed emails can read, mark as read, or delete questions,
//   so the audience cannot see each other's questions.
//   Anyone can read the open/closed switch, only the listed emails can change it.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['media@solidrockdublin.org'];
    }

    match /questions/{id} {
      allow create: if request.resource.data.keys().hasOnly(['text', 'name', 'to', 'read', 'createdAt'])
        && request.resource.data.keys().hasAll(['text', 'name', 'to', 'read', 'createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.to is string
        && request.resource.data.to.size() <= 60
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time;

      allow read, update, delete: if isAdmin();
    }

    match /settings/qa {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
